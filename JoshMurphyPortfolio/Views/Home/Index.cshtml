<script>
  // Scroll reveal
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        e.target.style.transitionDelay = (i % 3) * 0.1 + 's';
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  reveals.forEach(el => observer.observe(el));

  // Carousel state
  const state = {};

  function getState(trackId) {
    if (!state[trackId]) state[trackId] = { index: 0 };
    return state[trackId];
  }

  function getCount(trackId) {
    return document.getElementById(trackId).children.length;
  }

  function updateCarousel(trackId, dotsId) {
    const s = getState(trackId);
    const track = document.getElementById(trackId);
    track.style.transform = `translateX(${-s.index * 100}%)`;
    if (dotsId) {
      const dots = document.getElementById(dotsId).querySelectorAll('button');
      dots.forEach((d, i) => d.classList.toggle('active', i === s.index));
    }
  }

  function slide(trackId, dotsId, dir) {
    const s = getState(trackId);
    const count = getCount(trackId);
    s.index = (s.index + dir + count) % count;
    updateCarousel(trackId, dotsId);
  }

  function goTo(trackId, dotsId, index) {
    getState(trackId).index = index;
    updateCarousel(trackId, dotsId);
  }

  function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
  }

  function closeModalOutside(e, id) {
    if (e.target === document.getElementById(id)) closeModal(id);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-overlay.open').forEach(m => {
        m.classList.remove('open');
        document.body.style.overflow = '';
      });
    }
  });
</script>
